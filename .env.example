MONGODB_URI=mongodb://localhost:27027/varc
NEXTAUTH_URL=http://localhost:3099
AUTH_URL=http://localhost:3099
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3099

INITIAL_ADMIN_EMAIL=admin@varc.local
INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_NAME=VARC Admin

# Optional Google OAuth (button appears on /admin/login when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js aliases also work: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET

# --- Media storage ---
# local = disk under UPLOAD_DIR (default for development)
# s3    = S3-compatible (MinIO / AWS)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Optional overrides
# MEDIA_MAX_BYTES=52428800
# MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,application/pdf,text/plain,application/zip,application/x-zip-compressed,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation
# Prefer not enabling image/svg+xml (XSS risk when browsers execute SVG).
# MEDIA_PUBLIC_BASE_URL=http://localhost:3099

# --- S3 / MinIO (only when STORAGE_DRIVER=s3) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=varc-portal-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=http://localhost:9000/varc-portal-media

# --- Valkey / Redis (optional locally; required in k8s for CMS cache) ---
# Leave VALKEY_URL unset to skip caching (app still works against Mongo only).
# VALKEY_URL=redis://127.0.0.1:6379
# VALKEY_PASSWORD=your-local-password

# --- Cloudflare Email Sending (optional; form submission confirmation) ---
# REST API: POST /accounts/{account_id}/email/sending/send
# Token needs Email Sending: Edit. FROM must be on an onboarded domain.
# Rate limits use Valkey (VALKEY_URL) — fail-open if unset.
# CF_MAIL_API_TOKEN=
# CF_MAIL_ACCOUNT_ID=
# CF_MAIL_FROM=noreply@yourdomain.com
# CF_MAIL_MAX=500
# CF_MAIL_RATE_LIMIT=5
# CF_MAIL_RATE_LIMIT_WINDOW=1h

# --- Backup / Restore worker ---
# BACKUP_ARTIFACT_DIR=./.backup-artifacts
# BACKUP_S3_BUCKET=varc-portal-backups
# BACKUP_S3_PREFIX=backup-artifacts
# BACKUP_MAX_AGE_DAYS=7
# BACKUP_MAX_COUNT=10
# BACKUP_WORKER_POLL_MS=5000
# BACKUP_RESTORE_UPLOAD_MAX_BYTES=536870912

# --- Email worker (background mail queue) ---
# EMAIL_WORKER_ENABLED=1
# EMAIL_WORKER_POLL_MS=3000

# --- QSO logbook ---
# Max confirmation emails a non-admin user may send (admins bypass this limit).
# QSO_EMAIL_LIMIT=20

# --- VARC QSO REST API (Go, apps/api) ---
# Started automatically by pnpm dev:all alongside the portal and workers.
API_PORT=3100
API_PUBLIC_URL=http://localhost:3100
# Optional; falls back to AUTH_SECRET when unset.
# API_TOKEN_PEPPER=
# API_RATE_LIMIT=120
# API_RATE_LIMIT_WINDOW=1m
# API_RATE_LIMIT_WRITE=30
# API_CORS_ORIGINS=

# --- Operator map (MapLibre + MapTiler) ---
# Required for /{callsign}?view=map. Get a key at https://cloud.maptiler.com/
NEXT_PUBLIC_MAPTILER_API_KEY=
